# Configurações do Servidor Backend Express
PORT=3000
FRONTEND_URL=http://localhost:5173

# Supabase (PostgreSQL BaaS)
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_ANON_KEY=sua-chave-publica-anon
SUPABASE_SERVICE_ROLE_KEY=sua-chave-privada-service-role

# Segurança & Autenticação
JWT_SECRET=chave-secreta-forte-para-assinatura-jwt
INITIAL_ADMIN_PASSWORD=sua-senha-inicial-segura

# URL da API consumida pelo Frontend Vite (quando hospedado separadamente)
VITE_API_URL=http://localhost:3000
